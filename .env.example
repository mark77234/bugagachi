# 카카오 지도 JavaScript 키 (클라이언트 공개 키 — Kakao Developers에서 도메인 허용목록으로 보호)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── AI 갈붕 (OpenAI 호환 API) ─────────────────────────────────────────────
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 값만 바꾸면 코드 수정 없이 제공자·모델을 교체할 수 있어요.
#
#   Upstage(기본) : AI_BASE_URL=https://api.upstage.ai/v1  · AI_MODEL=solar-pro2
#   OpenAI        : AI_BASE_URL=https://api.openai.com/v1  · AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.upstage.ai/v1
AI_MODEL=solar-pro2
AI_API_KEY=
